# Copy outside the repository to /etc/debugych/production.env, mode 600.
# Generate a strong URL-safe POSTGRES_PASSWORD. Never use the local dev default.
POSTGRES_PASSWORD=
LLM_BASE_URL=https://triklz27.ru/v1
LLM_MODEL=gpt-6-luna
LLM_API_KEY=
LLM_MAX_CALLS=4
LLM_MAX_OUTPUT_TOKENS=4000
LLM_MAX_JOB_TOKENS=120000
LLM_MAX_DAILY_TOKENS=1000000
LLM_MAX_DAILY_CALLS=6
LLM_MAX_JOB_USD=1
LLM_MAX_DAILY_USD=1
LLM_TIMEOUT_SECONDS=40
LLM_JOB_DEADLINE_SECONDS=160
LLM_RESPONSE_FORMAT=json_schema
