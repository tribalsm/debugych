# Fill debugych.89-22-232-119.sslip.io, /etc/letsencrypt/live/debugych-sslip-20261030/fullchain.pem and /etc/letsencrypt/live/debugych-sslip-20261030/privkey.pem with verified existing values.
# 443 is already used by VPN. A separate TLS port avoids stopping it.
# Do not enable until DNS/certificate/authentication and gVisor have passed.
server {
    listen 9443 ssl;
    server_name debugych.89-22-232-119.sslip.io;
    ssl_certificate /etc/letsencrypt/live/debugych-sslip-20261030/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/debugych-sslip-20261030/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 40m;
    client_body_timeout 30s;
    client_header_timeout 15s;
    send_timeout 30s;
    access_log off;
    server_tokens off;
    add_header X-Content-Type-Options nosniff always;
    add_header Cache-Control no-store always;
    location / {
        limit_req zone=debugych_api burst=40 nodelay;
        limit_req_status 429;
        limit_conn debugych_conn 32;
        proxy_pass http://127.0.0.1:18081;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_read_timeout 100s;
        # Let the backend reject unauthorized uploads before buffering their bodies.
        proxy_request_buffering off;
        proxy_buffering off;
    }
}

# Debugych free-address HTTP redirect
server {
    listen 80;
    server_name debugych.89-22-232-119.sslip.io;
    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/debugych-acme;
        default_type text/plain;
    }
    location / { return 301 https://debugych.89-22-232-119.sslip.io:9443$request_uri; }
}
