DATABASE_URL=postgresql+psycopg://debugych:debugych@postgres:5432/debugych
POSTGRES_PASSWORD=debugych
REDIS_URL=redis://redis:6379/0
DATA_DIR=/data
RUNNER_URL=http://runner:8090
TASK_MODE=celery
LLM_BASE_URL=https://triklz27.ru/v1
LLM_MODEL=gpt-6-luna
LLM_API_KEY=
LLM_MAX_CALLS=4
LLM_CONTEXT_CHARS=40000
# json_schema by default; explicit json_object for older compatible providers.
LLM_RESPONSE_FORMAT=json_object
LLM_MAX_OUTPUT_TOKENS=4000
LLM_MAX_JOB_TOKENS=120000
LLM_MAX_DAILY_TOKENS=1000000
LLM_MAX_DAILY_CALLS=6
LLM_TIMEOUT_SECONDS=40
# Optional; only use values supported by the selected model/provider.
LLM_REASONING_EFFORT=
# Optional documentation-only review before any generated suite is saved/run.
LLM_TEST_REVIEW=0
LLM_JOB_DEADLINE_SECONDS=160
# Estimates use configured rates, NOT authoritative provider billing.
# Set rates at or above the selected model's current input/output prices.
LLM_INPUT_USD_PER_MILLION=10
LLM_OUTPUT_USD_PER_MILLION=30
LLM_MAX_JOB_USD=1
LLM_MAX_DAILY_USD=1
# Enabled automatically in Compose. Local development defaults to trusted demo.
SANDBOX_ENABLED=1
SUPERVISOR_URL=http://supervisor:8091
# Runner token is generated into a private named volume, never committed.
